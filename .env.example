# ===== 企业微信自建应用 =====
WECOM_CORPID=ww0000000000000000
WECOM_AGENTID=1000002
WECOM_SECRET=your-app-secret
# 回调配置（企业微信后台「接收消息」里设置的 Token 和 EncodingAESKey）
WECOM_TOKEN=your-callback-token
WECOM_ENCODING_AES_KEY=your-43-char-encoding-aes-key

# ===== 邮箱（IMAP）=====
# 常见服务器：QQ邮箱 imap.qq.com / 163 imap.163.com / Gmail imap.gmail.com / 腾讯企业邮箱 imap.exmail.qq.com
IMAP_HOST=imap.exmail.qq.com
IMAP_PORT=993
EMAIL_ADDRESS=you@example.com
# 注意：多数邮箱需要使用「授权码/客户端专用密码」，不是登录密码
EMAIL_PASSWORD=your-imap-auth-code
# 逗号分隔的文件夹名，留空则自动探测（收件箱 + 已发送）
MAIL_FOLDERS=
# 只整理最近多少天的邮件；0 = 不限时间
MAIL_LOOKBACK_DAYS=0
# 单次最多抓取的邮件数；0 = 不限数量
MAIL_MAX_RESULTS=0
# 单封邮件正文截断长度（字符）
EMAIL_BODY_CHARS=2000
# 往来邮件本地缓存目录：同一地址再次分析时只增量抓取新邮件；留空则禁用缓存
EMAIL_CACHE_DIR=data/emails

# ===== 大模型（OpenAI 兼容接口，可填 DeepSeek/月之暗面/通义等）=====
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=sk-xxx
LLM_MODEL=gpt-4o-mini
# 注入给模型的邮件上下文总长度上限（字符）
LLM_CONTEXT_CHARS=24000

# ===== 其他 =====
# 会话有效期（分钟），超时后需重新发起分析
SESSION_TTL_MINUTES=120
# 分析历史（提问与回复）持久化目录，按登录用户分目录隔离
SESSION_HISTORY_DIR=data/sessions
# ===== Web 用户与权限 =====
# 登录会话签名密钥，留空则自动生成并保存到 data/.secret_key
SECRET_KEY=
# 用户库文件
USERS_FILE=data/users.json
# 首次启动自动创建的管理员账号（仅用户库为空时生效，登录后请尽快修改）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# HTTP 服务端口
PORT=8000
